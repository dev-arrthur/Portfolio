# Produção: crie um banco MongoDB e informe a URI nas variáveis da Vercel.
MONGODB_URI=
MONGODB_DB=arthur_portfolio
STORAGE_DRIVER=mongodb

# Gere o hash com npm run password:hash. Nunca use NEXT_PUBLIC_ para segredos.
ADMIN_PASSWORD_HASH=
# Use pelo menos 32 caracteres aleatórios: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Atualize com o domínio final, incluindo https://, sem barra no fim.
NEXT_PUBLIC_SITE_URL=

# Somente desenvolvimento: STORAGE_DRIVER=local usa .data/ (ignorado pelo Git).
# Em produção e na Vercel, o driver local é recusado por segurança.
